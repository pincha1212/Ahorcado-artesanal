rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 32 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRoom(data) {
      return data.code is string && data.code.size() == 6 &&
             data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 30 &&
             data.hostId is string && data.hostId.size() > 0 && data.hostId.size() <= 64 &&
             data.mode in ['duel', 'turns', 'custom_word'] &&
             data.status in ['waiting', 'playing', 'round_ended', 'match_finished'] &&
             data.totalRounds is number && data.totalRounds >= 1 && data.totalRounds <= 10 &&
             data.currentRound is number && data.currentRound >= 1 && data.currentRound <= 10 &&
             data.mistakes is number && data.mistakes >= 0 && data.mistakes <= 8 &&
             data.maxMistakes is number && data.maxMistakes >= 6 && data.maxMistakes <= 8;
    }

    // Game Rooms collection
    match /rooms/{roomId} {
      allow get, list: if isValidId(roomId);

      // Create new room
      allow create: if isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().code == roomId;

      // Update room state during gameplay (guest joins, letters guessed, word set, round next)
      allow update: if isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().code == existing().code &&
                       incoming().hostId == existing().hostId;

      allow delete: if false;
    }
  }
}
